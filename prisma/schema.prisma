generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("agent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwilioPhoneNumber {
  id                  String         @id @default(cuid())
  phoneNumber         String         @unique
  twilioSid           String         @unique
  messagingServiceSid String?
  smsEnabled          Boolean        @default(true)
  mmsEnabled          Boolean        @default(true)
  status              String         @default("active")
  createdAt           DateTime       @default(now())
  conversations       Conversation[]
}

model Customer {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  phone           String         @unique
  email           String?
  smsOptIn        Boolean        @default(false)
  smsOptInAt      DateTime?
  smsOptOut       Boolean        @default(false)
  smsOptOutAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  conversations   Conversation[]
  messages        Message[]
  campaignRecipients CampaignRecipient[]
  smsQueue        SmsQueue[]
  optInRecords    OptInRecord[]
}

model Conversation {
  id              String            @id @default(cuid())
  customerId      String
  phoneNumberId   String?
  status          String            @default("open")
  unreadCount     Int               @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        Customer          @relation(fields: [customerId], references: [id])
  phoneNumber     TwilioPhoneNumber? @relation(fields: [phoneNumberId], references: [id])
  messages        Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  customerId     String
  direction      String       // inbound | outbound
  body           String
  twilioSid      String?      @unique
  status         String       @default("pending")
  fromNumber     String
  toNumber       String
  errorCode      String?
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
  deliveryEvents DeliveryEvent[]
}

model Campaign {
  id          String              @id @default(cuid())
  name        String
  message     String
  status      String              @default("draft")
  totalCount  Int                 @default(0)
  pending     Int                 @default(0)
  sent        Int                 @default(0)
  delivered   Int                 @default(0)
  failed      Int                 @default(0)
  optedOut    Int                 @default(0)
  dailyLimit  Int                 @default(200)
  schedules   Json?               // [{time: "09:00", count: 50}, ...]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  recipients  CampaignRecipient[]
  smsQueue    SmsQueue[]
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  customerId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model SmsQueue {
  id          String    @id @default(cuid())
  campaignId  String?
  customerId  String
  phone       String
  message     String
  scheduledAt DateTime
  status      String    @default("pending")
  attempts    Int       @default(0)
  twilioSid   String?
  lastError   String?
  createdAt   DateTime  @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])
}

model OptInRecord {
  id         String   @id @default(cuid())
  customerId String
  type       String   // START | STOP | HELP
  phone      String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model DeliveryEvent {
  id        String   @id @default(cuid())
  messageId String
  status    String
  rawData   Json?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
